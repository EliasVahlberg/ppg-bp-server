# Systemd service unit for a ppg-bp ingest server deployment.
#
# Install:
#   sudo cp ppg-pi-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ppg-pi-server
#
# Customise: edit `User=`, `WorkingDirectory=`, `Environment=` to match
# your setup (paths, the Tailscale IP to bind to).

[Unit]
Description=ppg-bp ingest server (FastAPI)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/ppg-pi-server/source/pi

# DuckDB and uploads live outside the source checkout so updates don't
# touch them. Adjust as needed.
Environment=PPG_PI_SERVER_DB_PATH=/var/lib/ppg-pi-server/sessions.duckdb
Environment=PPG_PI_SERVER_UPLOAD_DIR=/var/lib/ppg-pi-server/uploads
Environment=PPG_PI_SERVER_TOKENS_FILE=/var/lib/ppg-pi-server/tokens.json
# Default (PPG_PI_SERVER_BIND_HOST unset) is loopback-only, i.e. unreachable
# from the network. To actually receive uploads from a phone, bind to your
# Tailscale interface IP -- replace 100.x.y.z below with the real tailnet IP
# (get it with `tailscale ip -4`), or use 0.0.0.0 only if you're separately
# enforcing access control with a firewall.
Environment=PPG_PI_SERVER_BIND_HOST=100.x.y.z
Environment=PPG_PI_SERVER_BIND_PORT=8000

ExecStart=/home/pi/.local/bin/uv run ppg-pi-server serve

Restart=on-failure
RestartSec=5

# Reasonable hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/ppg-pi-server

[Install]
WantedBy=multi-user.target
