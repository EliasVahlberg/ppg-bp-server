# Snapshot backup of the ingest server's data. Triggered by the timer of the
# same name; safe to run at any time, since the DuckDB export is read-only and
# needs no downtime. Weekly full on Sundays, a diff against it on other days,
# nothing on days the store did not change; five fulls kept.
#
# Install (user service, no root):
#   cp systemd/ppg-pi-backup.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ppg-pi-backup.timer

[Unit]
Description=ppg-bp server data snapshot
After=ppg-pi-server.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/my_repos/ppg-bp-server

Environment=PPG_PI_SERVER_DB_PATH=%h/.local/share/ppg-pi-server/sessions.duckdb
Environment=PPG_PI_SERVER_UPLOAD_DIR=%h/.local/share/ppg-pi-server/uploads
Environment=PPG_PI_SERVER_TOKENS_FILE=%h/.local/share/ppg-pi-server/tokens.json
Environment=PPG_PI_BACKUP_DIR=%h/.local/share/ppg-pi-server-backups
# DuckDB's own cap; it spills to disk beyond this. With defaults it took 80 % of
# RAM and all 16 threads and peaked near 10 GB RSS. At 1GB a full export peaks
# at 1.44 GB RSS and takes 90 s (2GB: 2.68 GB, 86 s), measured 2026-10-25.
Environment=PPG_PI_BACKUP_MEMORY_LIMIT=1GB
Environment=PPG_PI_BACKUP_THREADS=2

ExecStart=%h/.local/bin/uv run scripts/backup.sh --keep-full 5 --full-weekday 7

# Backstops in case the in-process cap is exceeded (allocations outside DuckDB's
# buffer manager are not counted by memory_limit). The machine also hosts other
# services, which must not be pushed into swap by a backup.
MemoryMax=3G
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
CPUWeight=20
